  /* Mobile toggle */
  .mobile-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 9999px;
    width: 38px;
    height: 38px;
    cursor: pointer;
    color: var(--sl-color-gray-1);
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .mobile-toggle-btn svg line {
    transform-origin: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-toggle-btn.is-active svg line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-toggle-btn.is-active svg line:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle-btn.is-active svg line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .mobile-toggle-btn:hover {
    color: #ff5b00;
    border-color: #ff5b00;
    background: var(--sl-color-hairline);
  }

  /* Mobile Drawer with iPhone Safe Area & Smooth Scrolling */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-height: calc(100vh - 4.25rem);
    max-height: calc(100dvh - 4.25rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline);
    box-shadow: 0 16px 40px rgba(0,0,0,0.22);
    padding: 1.15rem 1rem max(2rem, env(safe-area-inset-bottom, 24px));
    z-index: 150;
  }

