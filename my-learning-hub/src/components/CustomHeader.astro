<script>
  // Mobile drawer and dropdown toggle support
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  
  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = mobileDrawer.classList.toggle('active');
      mobileBtn.classList.toggle('is-active', isOpen);
      mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Auto close drawer when any link is clicked
    mobileDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('active');
        mobileBtn.classList.remove('is-active');
        mobileBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // Close mobile drawer when clicking outside
    document.addEventListener('click', (e) => {
      if (mobileDrawer.classList.contains('active')) {
        if (!mobileDrawer.contains(e.target as Node) && !mobileBtn.contains(e.target as Node)) {
          mobileDrawer.classList.remove('active');
          mobileBtn.classList.remove('is-active');
          mobileBtn.setAttribute('aria-expanded', 'false');
        }
      }
    });
  }

  // Click toggle support for desktop dropdown button
  const dropdownWrapper = document.querySelector('.nav-dropdown-wrapper');
  const dropdownBtn = document.getElementById('coursesDropdownBtn');

  if (dropdownBtn && dropdownWrapper) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdownWrapper.classList.toggle('is-open');
    });

    document.addEventListener('click', (e) => {
      if (!dropdownWrapper.contains(e.target as Node)) {
        dropdownWrapper.classList.remove('is-open');
      }
    });
  }

  // Track Selector Modal Support
  const trackModal = document.getElementById('trackModal') as HTMLDialogElement | null;
  const openModalBtn = document.getElementById('openTrackModalBtn');
  const mobileOpenModalBtn = document.getElementById('mobileOpenTrackModalBtn');
  const closeModalBtn = document.getElementById('closeTrackModal');

  function openTrackModal() {
    if (trackModal) {
      trackModal.showModal();
      document.body.toggleAttribute('data-track-modal-open', true);
    }
  }

  function closeTrackModal() {
    if (trackModal) {
      trackModal.close();
      document.body.toggleAttribute('data-track-modal-open', false);
    }
  }

  openModalBtn?.addEventListener('click', openTrackModal);
  mobileOpenModalBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.remove('active');
    openTrackModal();
  });
  closeModalBtn?.addEventListener('click', closeTrackModal);

  trackModal?.addEventListener('click', (e) => {
    const box = trackModal.querySelector('.track-modal-box');
    if (box && !box.contains(e.target as Node)) {
      closeTrackModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && trackModal?.open) {
      closeTrackModal();
    }
  });
</script>

<style>
  .learnstack-navbar {
    width: 100%;
    height: 4.25rem;
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline);
    position: relative;
    z-index: 100;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 1rem;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .nav-container {
      padding: 0 1.5rem;
      gap: 1.5rem;
    }
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .nav-left {
      gap: 2.25rem;
    }
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none !important;
    color: var(--sl-color-gray-1) !important;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sl-color-gray-1);
  }

  @media (min-width: 640px) {
    .brand-title {
      font-size: 1.35rem;
    }
  }

  .brand-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: #ff5b00;
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 820px) {
    .desktop-nav {
      display: flex;
    }
  }

  /* Courses Dropdown Button */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .dropdown-trigger:hover,
  .nav-dropdown-wrapper.is-open .dropdown-trigger,
  .nav-dropdown-wrapper:hover .dropdown-trigger {
    color: #ff5b00;
    background: var(--sl-color-hairline);
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  .nav-dropdown-wrapper:hover .chevron-icon,
  .nav-dropdown-wrapper.is-open .chevron-icon {
    transform: rotate(180deg);
  }

  /* Mega Menu Panel */
  .mega-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -1rem;
    width: 660px;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.25), 0 0 1px 1px rgba(0, 0, 0, 0.06);
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 200;
  }

  .nav-dropdown-wrapper:hover .mega-menu,
  .nav-dropdown-wrapper.is-open .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-menu-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .column-header {
