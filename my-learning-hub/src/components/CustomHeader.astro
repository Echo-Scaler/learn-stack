---
import Search from './CustomSearch.astro';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<header class="learnstack-navbar">
  <div class="nav-container">
    <!-- Brand / Logo -->
    <div class="nav-left">
      <a href="/" class="brand-link" aria-label="LearnStack Home">
        <span class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="4" width="20" height="4" rx="2" fill="#ff5b00"/>
            <rect x="2" y="10" width="14" height="4" rx="2" fill="#ff5b00" opacity="0.8"/>
            <rect x="2" y="16" width="18" height="4" rx="2" fill="#ff5b00" opacity="0.6"/>
          </svg>
        </span>
        <span class="brand-title">LearnStack</span>
        <span class="brand-badge">PRO</span>
      </a>

      <!-- Desktop Nav Items with Dropdown -->
      <nav class="desktop-nav">
        <!-- Courses Dropdown Trigger -->
        <div class="nav-dropdown-wrapper">
          <button class="dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" id="coursesDropdownBtn">
            <span>Explore Courses</span>
            <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Rich Mega Dropdown Menu (3 Balanced Columns) -->
          <div class="mega-menu" role="menu" aria-labelledby="coursesDropdownBtn">
            <div class="mega-menu-inner">
              <!-- Column 1: Software Engineering -->
              <div class="menu-column">
                <div class="column-header">
                  <div class="col-header-left">
                    <span class="col-header-icon">💻</span>
                    <span class="col-header-text">SOFTWARE ENGINEERING</span>
                  </div>
                  <span class="col-header-pill">5 TRACKS</span>
                </div>

                <a href="/php/00_overview/" class="course-menu-item item-php">
                  <div class="item-icon-box php-bg">🐘</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">PHP Core &amp; Patterns</span>
                      <span class="item-badge badge-php">24 Ch</span>
                    </div>
                    <span class="item-desc">3 Sections • PHP 8.x, OOP, MVC &amp; GoF</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/javascript/00_overview/" class="course-menu-item item-js">
                  <div class="item-icon-box js-bg">⚡</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Modern JavaScript</span>
                      <span class="item-badge badge-js">13 Ch</span>
                    </div>
                    <span class="item-desc">2 Sections • ES6+, V8 Engine &amp; Async</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/laravel/00_overview/" class="course-menu-item item-laravel">
                  <div class="item-icon-box laravel-bg">🔺</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Laravel Enterprise</span>
                      <span class="item-badge badge-laravel">20 Ch</span>
                    </div>
                    <span class="item-desc">3 Sections • IoC, Eloquent, Queues &amp; APIs</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/mysql/00_overview/" class="course-menu-item item-mysql">
                  <div class="item-icon-box mysql-bg">🗄️</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">MySQL Architecture</span>
                      <span class="item-badge badge-mysql">21 Ch</span>
                    </div>
                    <span class="item-desc">3 Sections • InnoDB, Indexing &amp; HA</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/java/00_overview/" class="course-menu-item item-java">
                  <div class="item-icon-box java-bg">☕</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Java Enterprise &amp; Spring</span>
                      <span class="item-badge badge-java">20 Ch</span>
                    </div>
                    <span class="item-desc">4 Sections • 5-Level Mastery: JVM, OOP, SQL, Spring &amp; Docker</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>
              </div>

              <!-- Column 2: Cloud, DevOps & Infrastructure -->
              <div class="menu-column">
                <div class="column-header">
                  <div class="col-header-left">
                    <span class="col-header-icon">☁️</span>
                    <span class="col-header-text">CLOUD, DEVOPS &amp; CMS</span>
                  </div>
                  <span class="col-header-pill">6 TRACKS</span>
                </div>

                <a href="/linux/00_overview/" class="course-menu-item item-linux">
                  <div class="item-icon-box linux-bg">🐧</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Linux Server Engineering</span>
                      <span class="item-badge badge-linux">9 Phases</span>
                    </div>
                    <span class="item-desc">0 to 4-Year Mentorship • SysAdmin &amp; Ops</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/git/00_overview/" class="course-menu-item item-git">
                  <div class="item-icon-box git-bg">🐙</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Git &amp; GitHub Enterprise</span>
                      <span class="item-badge badge-git">7 Ch</span>
                    </div>
                    <span class="item-desc">3 Sections • Blobs, Rebase -i, PRs &amp; Reflog</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/devops/00_overview/" class="course-menu-item item-devops">
                  <div class="item-icon-box devops-bg">🐳</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Docker &amp; DevOps Cloud</span>
                      <span class="item-badge badge-devops">46 Ch</span>
                    </div>
                    <span class="item-desc">2 Sections • K8s, Helm Charts &amp; GitOps</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/aws/00_overview/" class="course-menu-item item-aws">
                  <div class="item-icon-box aws-bg">☁️</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">AWS Cloud &amp; DevOps Labs</span>
                      <span class="item-badge badge-aws">48 Labs</span>
                    </div>
                    <span class="item-desc">4 Sections • SAA-C03 &amp; Real Work Labs</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/networking/00_overview/" class="course-menu-item item-net">
                  <div class="item-icon-box net-bg">🌐</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Networking &amp; Automation</span>
                      <span class="item-badge badge-net">6 Ch</span>
                    </div>
                    <span class="item-desc">1 Section • CIDR, VLSM &amp; Terraform VPC</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/eccube/00_overview/" class="course-menu-item item-eccube">
                  <div class="item-icon-box eccube-bg">🛍️</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">EC-CUBE 4 Enterprise</span>
                      <span class="item-badge badge-eccube">217 Ch</span>
                    </div>
                    <span class="item-desc">5 Sections • Symfony, DB &amp; 17 Modules</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>
              </div>

              <!-- Column 3: Languages & Certifications -->
              <div class="menu-column">
                <div class="column-header">
                  <div class="col-header-left">
                    <span class="col-header-icon">⛩️</span>
                    <span class="col-header-text">LANGUAGES &amp; EXAMS</span>
                  </div>
                  <span class="col-header-pill">4 TRACKS</span>
                </div>

                <a href="/japanese-grammar/00_n1_overview_and_strategy/01_n1_exam_structure_and_study_guide/" class="course-menu-item item-jg">
                  <div class="item-icon-box japanese-bg">⛩️</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Japanese N1 Grammar</span>
                      <span class="item-badge badge-jg">10 Ch</span>
                    </div>
                    <span class="item-desc">3 Sections • N1 Rules, Romaji &amp; Star</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/japanese-vocab/01_high_frequency_verbs/" class="course-menu-item item-jv">
                  <div class="item-icon-box vocab-bg">📖</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Japanese N1 Vocab (570+)</span>
                      <span class="item-badge badge-jv">570+ Vocab</span>
                    </div>
                    <span class="item-desc">2 Sections • Verbs, Nouns &amp; IT Lexicon</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/japanese-kanji/00_n1_kanji_overview_and_strategy/" class="course-menu-item item-jk">
                  <div class="item-icon-box kanji-bg">🈸</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">Japanese N1 Kanji</span>
                      <span class="item-badge badge-jk">10 Ch</span>
                    </div>
                    <span class="item-desc">2 Sections • Radicals, Ateji &amp; Tests</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>

                <a href="/toeic/00_study_plan_roadmap/01_score_breakdown_and_strategy/" class="course-menu-item item-toeic">
                  <div class="item-icon-box toeic-bg">🎯</div>
                  <div class="item-text">
                    <div class="item-title-row">
                      <span class="item-title">TOEIC Exam 800+ Hub</span>
                      <span class="item-badge badge-toeic">75 Tests</span>
                    </div>
                    <span class="item-desc">7 Sections • 10-Week Plan &amp; 800 Vocab</span>
                  </div>
                  <span class="item-hover-arrow">→</span>
                </a>
              </div>
            </div>

            <div class="menu-footer-callout">
              <a href="/roadmaps/" class="callout-link">
                <span class="callout-link-left">
                  <span class="callout-icon">🗺️</span>
                  <span>Explore Full Career Roadmaps</span>
                </span>
                <span class="callout-arrow">→</span>
              </a>
              <a href="/curriculum/" class="callout-link">
                <span class="callout-link-left">
                  <span class="callout-icon">📋</span>
                  <span>Complete 515+ Curriculum Index</span>
                </span>
                <span class="callout-arrow">→</span>
              </a>
            </div>
          </div>
        </div>

        <a href="/roadmaps/" class="nav-direct-link">
          Roadmaps
        </a>
        <a href="/curriculum/" class="nav-direct-link">
          Curriculum
        </a>
      </nav>
    </div>

    <!-- Actions Right -->
    <div class="nav-right">
      <div class="search-box">
        <Search />
      </div>
      <div class="theme-box">
        <ThemeSelect />
      </div>
      <button type="button" class="nav-cta-btn" id="openTrackModalBtn">
        Start Learning ↗
      </button>
      
      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-toggle-btn" id="mobileMenuBtn" aria-label="Toggle menu" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="mobile-drawer-inner">
      <!-- Section 1: Software Engineering -->
      <div class="mobile-section-group">
        <div class="mobile-section-title">
          <span class="mobile-sec-name">💻 SOFTWARE ENGINEERING</span>
          <span class="mobile-section-pill">5 TRACKS</span>
        </div>
        <div class="mobile-track-list">
          <a href="/php/00_overview/" class="mobile-card-item mobile-item-php">
            <span class="mobile-card-icon php-bg">🐘</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">PHP Core &amp; Patterns</span>
              <span class="mobile-card-sub">24 Chapters • OOP, MVC &amp; GoF</span>
            </div>
            <span class="mobile-card-badge badge-php">24 Ch</span>
          </a>

          <a href="/javascript/00_overview/" class="mobile-card-item mobile-item-js">
            <span class="mobile-card-icon js-bg">⚡</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Modern JavaScript</span>
              <span class="mobile-card-sub">13 Chapters • ES6+, V8 &amp; Async</span>
            </div>
            <span class="mobile-card-badge badge-js">13 Ch</span>
          </a>

          <a href="/laravel/00_overview/" class="mobile-card-item mobile-item-laravel">
            <span class="mobile-card-icon laravel-bg">🔺</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Laravel Enterprise</span>
              <span class="mobile-card-sub">20 Chapters • IoC, Queues &amp; APIs</span>
            </div>
            <span class="mobile-card-badge badge-laravel">20 Ch</span>
          </a>

          <a href="/mysql/00_overview/" class="mobile-card-item mobile-item-mysql">
            <span class="mobile-card-icon mysql-bg">🗄️</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">MySQL Architecture</span>
              <span class="mobile-card-sub">21 Chapters • InnoDB &amp; Indexes</span>
            </div>
            <span class="mobile-card-badge badge-mysql">21 Ch</span>
          </a>

          <a href="/java/00_overview/" class="mobile-card-item mobile-item-java">
            <span class="mobile-card-icon java-bg">☕</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Java Enterprise &amp; Spring</span>
              <span class="mobile-card-sub">20 Chapters • 5-Level Mastery &amp; Spring Boot</span>
            </div>
            <span class="mobile-card-badge badge-java">20 Ch</span>
          </a>
        </div>
      </div>

      <!-- Section 2: Cloud, DevOps & CMS -->
      <div class="mobile-section-group">
        <div class="mobile-section-title">
          <span class="mobile-sec-name">☁️ CLOUD, DEVOPS &amp; CMS</span>
          <span class="mobile-section-pill">6 TRACKS</span>
        </div>
        <div class="mobile-track-list">
          <a href="/linux/00_overview/" class="mobile-card-item mobile-item-linux">
            <span class="mobile-card-icon linux-bg">🐧</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Linux Server Engineering</span>
              <span class="mobile-card-sub">9 Phases • 0 to 4-Year Mentorship</span>
            </div>
            <span class="mobile-card-badge badge-linux">9 Phases</span>
          </a>

          <a href="/git/00_overview/" class="mobile-card-item mobile-item-git">
            <span class="mobile-card-icon git-bg">🐙</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Git &amp; GitHub Enterprise</span>
              <span class="mobile-card-sub">7 Chapters • Rebase, PRs &amp; Reflog</span>
            </div>
            <span class="mobile-card-badge badge-git">7 Ch</span>
          </a>

          <a href="/devops/00_overview/" class="mobile-card-item mobile-item-devops">
            <span class="mobile-card-icon devops-bg">🐳</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Docker &amp; DevOps Cloud</span>
              <span class="mobile-card-sub">46 Chapters • K8s &amp; CI/CD</span>
            </div>
            <span class="mobile-card-badge badge-devops">46 Ch</span>
          </a>

          <a href="/aws/00_overview/" class="mobile-card-item mobile-item-aws">
            <span class="mobile-card-icon aws-bg">☁️</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">AWS Cloud &amp; DevOps Labs</span>
              <span class="mobile-card-sub">48 Chapters • SAA Real Labs</span>
            </div>
            <span class="mobile-card-badge badge-aws">48 Labs</span>
          </a>

          <a href="/networking/00_overview/" class="mobile-card-item mobile-item-net">
            <span class="mobile-card-icon net-bg">🌐</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Networking &amp; Automation</span>
              <span class="mobile-card-sub">6 Chapters • CIDR &amp; Terraform</span>
            </div>
            <span class="mobile-card-badge badge-net">6 Ch</span>
          </a>

          <a href="/eccube/00_overview/" class="mobile-card-item mobile-item-eccube">
            <span class="mobile-card-icon eccube-bg">🛍️</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">EC-CUBE 4 Enterprise</span>
              <span class="mobile-card-sub">217 Chapters • Symfony &amp; DB</span>
            </div>
            <span class="mobile-card-badge badge-eccube">217 Ch</span>
          </a>
        </div>
      </div>

      <!-- Section 3: Languages & Certifications -->
      <div class="mobile-section-group">
        <div class="mobile-section-title">
          <span class="mobile-sec-name">⛩️ LANGUAGES &amp; EXAMS</span>
          <span class="mobile-section-pill">4 TRACKS</span>
        </div>
        <div class="mobile-track-list">
          <a href="/japanese-grammar/00_n1_overview_and_strategy/01_n1_exam_structure_and_study_guide/" class="mobile-card-item mobile-item-jg">
            <span class="mobile-card-icon japanese-bg">⛩️</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Japanese N1 Grammar</span>
              <span class="mobile-card-sub">10 Chapters • N1 Rules &amp; Star</span>
            </div>
            <span class="mobile-card-badge badge-jg">10 Ch</span>
          </a>

          <a href="/japanese-vocab/01_high_frequency_verbs/" class="mobile-card-item mobile-item-jv">
            <span class="mobile-card-icon vocab-bg">📖</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Japanese N1 Vocab (570+)</span>
              <span class="mobile-card-sub">570+ Words • Verbs &amp; IT</span>
            </div>
            <span class="mobile-card-badge badge-jv">570+</span>
          </a>

          <a href="/japanese-kanji/00_n1_kanji_overview_and_strategy/" class="mobile-card-item mobile-item-jk">
            <span class="mobile-card-icon kanji-bg">🈸</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">Japanese N1 Kanji</span>
              <span class="mobile-card-sub">10 Chapters • Radicals &amp; Tests</span>
            </div>
            <span class="mobile-card-badge badge-jk">10 Ch</span>
          </a>

          <a href="/toeic/00_study_plan_roadmap/01_score_breakdown_and_strategy/" class="mobile-card-item mobile-item-toeic">
            <span class="mobile-card-icon toeic-bg">🎯</span>
            <div class="mobile-card-info">
              <span class="mobile-card-title">TOEIC Exam 800+ Hub</span>
              <span class="mobile-card-sub">75 Tests • 10-Week Roadmap</span>
            </div>
            <span class="mobile-card-badge badge-toeic">75 Ch</span>
          </a>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="mobile-quick-links">
        <a href="/roadmaps/" class="mobile-quick-link">
          <span class="quick-link-left">
            <span>🗺️</span>
            <span>Engineering Roadmaps</span>
          </span>
          <span class="quick-link-arrow">→</span>
        </a>
        <a href="/curriculum/" class="mobile-quick-link">
          <span class="quick-link-left">
            <span>📋</span>
            <span>Complete 515+ Curriculum</span>
          </span>
          <span class="quick-link-arrow">→</span>
        </a>
      </div>

      <div class="mobile-actions">
        <button type="button" class="mobile-cta-btn" id="mobileOpenTrackModalBtn">
          Choose Learning Track ↗
        </button>
      </div>
    </div>
  </div>

  <!-- Quick Track Selector Modal -->
  <dialog id="trackModal" class="track-dialog" aria-label="Select Learning Track">
    <div class="track-modal-box">
      <div class="track-modal-header">
        <div class="modal-title-wrap">
          <span class="modal-eyebrow">LEARNSTACK PRO • TRACK SELECTOR</span>
          <h2 class="modal-heading">Choose Your Learning Program</h2>
        </div>
        <button type="button" class="modal-close-btn" id="closeTrackModal" aria-label="Close dialog">✕</button>
      </div>

      <div class="track-modal-body">
        <!-- Group 1: Software & Database Engineering (4 tracks, 2x2 grid) -->
        <div class="modal-group-title">
          <span>💻 SOFTWARE &amp; DATABASE ENGINEERING</span>
          <span class="modal-group-pill">5 CORE TRACKS</span>
        </div>
        <div class="modal-tracks-grid">
          <a href="/php/00_overview/" class="track-select-card card-featured-php">
            <div class="card-icon-part">🐘</div>
            <div class="card-info-part">
              <div class="card-top-row">
                <span class="card-name">PHP Core &amp; Patterns</span>
                <span class="badge-new-pulse" style="background:#7c3aed; color:#fff;">24 CH</span>
              </div>
              <p class="card-sub">3 Sections • 24 Chapters • PHP 8.x, OOP, MVC, GoF Patterns &amp; Enterprise Caching</p>
            </div>
            <div class="card-action-part" style="color:#7c3aed;">Start PHP →</div>
          </a>

          <a href="/javascript/00_overview/" class="track-select-card card-featured-js">
            <div class="card-icon-part">⚡</div>
            <div class="card-info-part">
              <div class="card-top-row">
                <span class="card-name">Modern JavaScript (ES6+ to V8)</span>
                <span class="badge-new-pulse" style="background:#ca8a04; color:#fff;">13 CH</span>
              </div>
              <p class="card-sub">2 Sections • 13 Chapters • V8 Engine, Event Loop, Closures, Promises &amp; Async/Await</p>
            </div>
            <div class="card-action-part" style="color:#ca8a04;">Start JS →</div>
          </a>

          <a href="/laravel/00_overview/" class="track-select-card card-featured-laravel">
            <div class="card-icon-part">🔺</div>
            <div class="card-info-part">
              <div class="card-top-row">
                <span class="card-name">Laravel Enterprise Architecture</span>
                <span class="badge-new-pulse" style="background:#ef4444; color:#fff;">20 CH</span>
              </div>
              <p class="card-sub">3 Sections • 20 Chapters • IoC Container, Eloquent, Queues, Sanctum &amp; Cloud Scaling</p>
            </div>
            <div class="card-action-part" style="color:#ef4444;">Start Laravel →</div>
          </a>

