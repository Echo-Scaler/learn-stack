  (function() {
    function detectSector() {
      var m = window.location.pathname.match(/\/(japanese-grammar|japanese-vocab|japanese-kanji|aws|php|javascript|laravel|mysql|devops|eccube|toeic|java|git|linux)\b/);
      if (m) {
        document.documentElement.setAttribute('data-sector', m[1]);
      } else {
        document.documentElement.removeAttribute('data-sector');
      }
    }
    detectSector();
    document.addEventListener('astro:page-load', detectSector);
    document.addEventListener('DOMContentLoaded', detectSector);
  })();
</script>

<script>
  // Mobile drawer and dropdown toggle support
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  
  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = mobileDrawer.classList.toggle('active');
      mobileBtn.classList.toggle('is-active', isOpen);
      mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Auto close drawer when any link is clicked
    mobileDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('active');
        mobileBtn.classList.remove('is-active');
        mobileBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // Close mobile drawer when clicking outside
    document.addEventListener('click', (e) => {
      if (mobileDrawer.classList.contains('active')) {
        if (!mobileDrawer.contains(e.target as Node) && !mobileBtn.contains(e.target as Node)) {
          mobileDrawer.classList.remove('active');
          mobileBtn.classList.remove('is-active');
          mobileBtn.setAttribute('aria-expanded', 'false');
        }
      }
    });
  }

  // Click toggle support for desktop dropdown button
  const dropdownWrapper = document.querySelector('.nav-dropdown-wrapper');
  const dropdownBtn = document.getElementById('coursesDropdownBtn');

  if (dropdownBtn && dropdownWrapper) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdownWrapper.classList.toggle('is-open');
    });

    document.addEventListener('click', (e) => {
      if (!dropdownWrapper.contains(e.target as Node)) {
        dropdownWrapper.classList.remove('is-open');
      }
    });
  }

  // Track Selector Modal Support
  const trackModal = document.getElementById('trackModal') as HTMLDialogElement | null;
  const openModalBtn = document.getElementById('openTrackModalBtn');
  const mobileOpenModalBtn = document.getElementById('mobileOpenTrackModalBtn');
  const closeModalBtn = document.getElementById('closeTrackModal');

  function openTrackModal() {
    if (trackModal) {
      trackModal.showModal();
      document.body.toggleAttribute('data-track-modal-open', true);
    }
  }

  function closeTrackModal() {
    if (trackModal) {
      trackModal.close();
      document.body.toggleAttribute('data-track-modal-open', false);
    }
  }

  openModalBtn?.addEventListener('click', openTrackModal);
  mobileOpenModalBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.remove('active');
    openTrackModal();
  });
  closeModalBtn?.addEventListener('click', closeTrackModal);

  trackModal?.addEventListener('click', (e) => {
    const box = trackModal.querySelector('.track-modal-box');
    if (box && !box.contains(e.target as Node)) {
      closeTrackModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && trackModal?.open) {
      closeTrackModal();
    }
  });
</script>

