                <div class="column-header">SOFTWARE ENGINEERING</div>
                <a href="/php/01_variables/" class="course-menu-item">
                  <div class="item-icon-box php-bg">🐘</div>
                  <div class="item-text">
                    <span class="item-title">PHP Core & Patterns</span>
