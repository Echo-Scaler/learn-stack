    color: var(--sl-color-gray-4);
    cursor: default;
    min-width: 16px;
    flex-shrink: 0;
  }

  .page-pill.nav-arrow {
    font-size: 0.75rem;
    background: var(--sl-color-hairline);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
