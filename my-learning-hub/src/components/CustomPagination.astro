    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: nowrap;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .numbered-pills-list {
      gap: 0.2rem;
    }
  }

  .page-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 0.45rem;
    border-radius: 8px;
    background: var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.15s ease;
    user-select: none;
    flex-shrink: 0;
