  }

  .sector-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--sl-color-hairline);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-hairline);
