    const num = parseInt(clean.match(/(\d+)/)?.[1] || '0', 10);
    if (clean.includes('00_overview') || num <= 3) {
      let subTag = 'JVM Foundations';
      if (clean.includes('00_overview')) subTag = 'Course Roadmap';
      else if (num === 1) subTag = 'Syntax & Primitive Types';
      else if (num === 2) subTag = 'Stack vs Heap Memory';
      else if (num === 3) subTag = 'Classes & Constructors';
      return {
        sectionKey: 'java_foundations',
        sectionTitle: '1. Core Foundations & JVM Memory',
        sectionIcon: '☕',
        badge: 'JVM CORE',
        subTag
      };
    }
    if (num >= 4 && num <= 8) {
      let subTag = 'OOP Mastery';
      if (num === 4) subTag = 'Encapsulation & Access';
      else if (num === 5) subTag = 'Inheritance & Polymorphism';
      else if (num === 6) subTag = 'Abstraction & Interfaces';
      else if (num === 7) subTag = 'Strings & Wrappers';
      else if (num === 8) subTag = 'Exception Handling';
      return {
        sectionKey: 'java_oop',
        sectionTitle: '2. OOP Mastery & Exception Handling',
        sectionIcon: '🛡️',
        badge: 'OOP ARCHITECTURE',
        subTag
      };
    }
    if (num >= 9) {
      let subTag = 'Enterprise Engineering';
      if (num === 9) subTag = 'Collections Internals';
      else if (num === 10) subTag = 'Generics & PECS';
      else if (num === 11) subTag = 'Lambdas & Streams';
      else if (num === 12) subTag = 'Multithreading & Locks';
      else if (num === 13) subTag = 'GoF Design Patterns';
      else if (num === 14) subTag = 'Spring Boot & Database';
      return {
        sectionKey: 'java_senior',
        sectionTitle: '3. Advanced Concurrency, Patterns & Spring',
        sectionIcon: '🚀',
        badge: '4-YEAR SENIOR',
        subTag
      };
    }
  }

  // Default fallback
  return { sectionKey: 'general', sectionTitle: `${courseName || 'Course'} Curriculum`, sectionIcon: '📚', badge: 'LESSONS', subTag: courseName || 'Lessons' };
}

interface EnrichedLesson {
  href: string;
  label: string;
  cleanTitle: string;
  isCurrent: boolean;
  globalIndex: number;
  sectionKey: string;
  sectionTitle: string;
  sectionIcon: string;
  badge: string;
  subTag?: string;
}

const enrichedLessons: EnrichedLesson[] = sectorLessons.map((lesson, idx) => {
  const isCur = idx === currentIndex;
  let cleanTitle = (lesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '').trim();
  const meta = classifyLesson(lesson.href, sectorTitle);

  // If title is a generic "Overview", "Readme", or "Course Overview", qualify with module or parent folder name
  if (/^(course\s+)?overview$/i.test(cleanTitle) || /^readme$/i.test(cleanTitle)) {
    const segments = lesson.href.split('/').filter(Boolean);
    const parentSeg = segments[segments.length - 2] || '';
    const formatted = parentSeg
      .replace(/^\d+[\-_]/, '')
      .split(/[-_]/)
      .map(w => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    cleanTitle = formatted ? `${formatted} Overview` : (meta.subTag ? `${meta.subTag} Overview` : `${sectorTitle} Course Overview & Roadmap`);
  }

  return {
    href: lesson.href,
    label: lesson.label,
    cleanTitle,
    isCurrent: isCur,
    globalIndex: idx,
    sectionKey: meta.sectionKey,
    sectionTitle: meta.sectionTitle,
    sectionIcon: meta.sectionIcon,
    badge: meta.badge,
    subTag: meta.subTag,
  };
});

// Group lessons into structured sections
interface SectionGroup {
  key: string;
  title: string;
  icon: string;
  badge: string;
  isCurrentSection: boolean;
  lessons: EnrichedLesson[];
}

const sectionGroups: SectionGroup[] = [];
const sectionMap = new Map<string, SectionGroup>();

for (const lesson of enrichedLessons) {
  if (!sectionMap.has(lesson.sectionKey)) {
    const isCurrentSec = lesson.sectionKey === enrichedLessons[currentIndex]?.sectionKey;
    const group: SectionGroup = {
      key: lesson.sectionKey,
      title: lesson.sectionTitle,
      icon: lesson.sectionIcon,
      badge: lesson.badge,
      isCurrentSection: isCurrentSec,
      lessons: [],
    };
    sectionMap.set(lesson.sectionKey, group);
    sectionGroups.push(group);
  }
  sectionMap.get(lesson.sectionKey)!.lessons.push(lesson);
}

// Ensure section groups always render in strict numerical order (1, 2, 3, 4, 5...)
sectionGroups.sort((a, b) => a.title.localeCompare(b.title, undefined, { numeric: true }));

const currentEnrichedLesson = currentIndex >= 0 ? enrichedLessons[currentIndex] : null;
const cleanCurrentTitle = currentEnrichedLesson ? currentEnrichedLesson.cleanTitle : 'Select Chapter';
---

{totalLessons > 0 && (
  <nav class="sector-pagination print:hidden" aria-label="Course Lesson Navigation">
    <!-- Modern Header Row: Sector Pill, Module Pill & Interactive Chapter Selector -->
    <div class="pagination-header">
      <div class="header-left-meta">
        <a href={sectorLessons[0]?.href || '/'} class="sector-badge" title={`${sectorTitle} Course Overview`}>
          <span class="sector-icon">{sectorIcon}</span>
          <span class="sector-name">{sectorTitle}</span>
        </a>

        {currentEnrichedLesson && (
          <span class="current-module-chip" title={currentEnrichedLesson.sectionTitle}>
            <span class="chip-icon">{currentEnrichedLesson.sectionIcon}</span>
            <span class="chip-label">{currentEnrichedLesson.subTag || currentEnrichedLesson.badge}</span>
          </span>
        )}
      </div>

      <!-- Modern Quick Chapter Navigator Trigger -->
      <div class="header-right-actions">
        <button
          type="button"
          class="modern-chapter-trigger-btn"
          id="openModernNavBtn"
          aria-haspopup="dialog"
          title="Open Chapter Navigator"
        >
          <span class="btn-icon">📑</span>
          <span class="btn-title-truncate">{cleanCurrentTitle}</span>
          <span class="btn-dropdown-arrow">▾</span>
        </button>

        <button
          type="button"
          class="switch-track-btn"
          onclick="const m = document.getElementById('trackModal'); if (m && typeof m.showModal === 'function') { m.showModal(); } else { window.location.href = '/#programs'; }"
          title="Switch to another track"
        >
          <span>All Tracks ▾</span>
        </button>
      </div>
    </div>

    <!-- Progress Line -->
    <div class="progress-track" role="progressbar" aria-valuenow={progressPercent} aria-valuemin="0" aria-valuemax="100">
      <div class="progress-fill" style={`width: ${progressPercent}%;`}></div>
    </div>

    <!-- Numbered Page Pills -->
    {totalLessons > 1 && (
      <div class="numbered-pagination">
        {prevLesson ? (
          <a href={prevLesson.href} class="page-pill nav-arrow" title="Previous Lesson">
            ◀
          </a>
        ) : (
          <span class="page-pill nav-arrow disabled" aria-disabled="true">
            ◀
          </span>
        )}

        <div class="numbered-pills-list">
          {paginationItems.map((item) => {
            if (item.type === 'ellipsis') {
              return <span class="page-pill ellipsis">…</span>;
            }
            const isCur = item.index === currentIndex;
            const targetLesson = item.index !== undefined ? sectorLessons[item.index] : null;
            return targetLesson ? (
              <a
                href={targetLesson.href}
                class={`page-pill ${isCur ? 'active' : ''}`}
                title={`Go to Lesson ${item.num}: ${targetLesson.label}`}
                aria-current={isCur ? 'page' : undefined}
              >
                {item.num}
              </a>
            ) : null;
          })}
        </div>

        {nextLesson ? (
          <a href={nextLesson.href} class="page-pill nav-arrow" title="Next Lesson">
            ▶
          </a>
        ) : (
          <span class="page-pill nav-arrow disabled" aria-disabled="true">
            ▶
          </span>
        )}
      </div>
    )}

    <!-- Prev & Next Action Cards (Modern Klook Style) -->
    <div class="cards-grid">
      <!-- Previous Card -->
      {prevLesson ? (
        <a href={prevLesson.href} class="lesson-card prev-card" rel="prev">
          <div class="card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </div>
          <div class="card-content">
            <span class="card-label">PREVIOUS LESSON</span>
            <span class="card-title">{(prevLesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '')}</span>
          </div>
        </a>
      ) : (
        <div class="lesson-card disabled-card">
          <div class="card-arrow muted-arrow">✦</div>
          <div class="card-content">
            <span class="card-label">COURSE START</span>
            <span class="card-title">First chapter of this track</span>
          </div>
        </div>
      )}

      <!-- Next Card -->
      {nextLesson ? (
        <a href={nextLesson.href} class="lesson-card next-card" rel="next">
          <div class="card-content text-right">
            <span class="card-label">NEXT LESSON</span>
            <span class="card-title">{(nextLesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '')}</span>
          </div>
          <div class="card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ) : (
        <a href="/curriculum/" class="lesson-card complete-card">
          <div class="card-content text-right">
            <span class="card-label">🎉 COURSE COMPLETED</span>
            <span class="card-title">Explore All Programs ↗</span>
          </div>
          <div class="card-arrow celebration-arrow">🏆</div>
        </a>
      )}
    </div>

    <!-- ========================================================
         MODERN ACCORDION CHAPTER NAVIGATOR DRAWER
         ======================================================== -->
    <dialog id="modernNavModal" class="modern-nav-dialog" aria-label="Course Chapter Navigator">
      <div class="nav-dialog-backdrop" id="dialogBackdrop"></div>
      <div class="nav-dialog-container">
        <!-- Dialog Header -->
        <div class="dialog-header">
          <div class="header-info">
            <div class="header-eyebrow">
              <span class="eyebrow-icon">{sectorIcon}</span>
              <span class="eyebrow-text">{sectorTitle} TRACK</span>
              <span class="eyebrow-badge">{sectionGroups.length} SECTIONS</span>
            </div>
            <h2 class="header-heading">Course Chapters &amp; Structure</h2>
          </div>
          <button type="button" class="dialog-close-btn" id="closeModernNavBtn" aria-label="Close chapter explorer">✕</button>
        </div>

        <!-- Search Bar -->
        <div class="dialog-search-bar">
          <div class="search-input-wrapper">
            <span class="search-magnifier">🔍</span>
            <input
              type="text"
              id="modernChapterSearchInput"
              class="search-input"
              placeholder="Search chapters by keyword (e.g. payment, purchaseflow, csv, stock)..."
              autocomplete="off"
            />
            <button type="button" id="clearSearchInputBtn" class="clear-btn" style="display:none;" aria-label="Clear search">✕</button>
          </div>
          <div class="search-feedback">
            <span id="searchMatchCountText" class="match-count">{totalLessons} chapters available</span>
            <span class="search-hint"><kbd>ESC</kbd> to close</span>
          </div>
        </div>

        <!-- Collapsible Section Accordions -->
        <div class="sections-accordion-list" id="sectionsAccordionList">
          {sectionGroups.map((group) => {
            const isCurrentlyActiveSection = group.isCurrentSection;
            return (
              <div
                class={`section-accordion-item ${isCurrentlyActiveSection ? 'is-open is-active-section' : ''}`}
                data-section-key={group.key}
              >
                <!-- Section Accordion Header -->
                <button
                  type="button"
                  class="accordion-trigger-btn"
                  aria-expanded={isCurrentlyActiveSection ? 'true' : 'false'}
                >
                  <div class="trigger-left">
                    <span class="section-icon">{group.icon}</span>
                    <span class="section-name">{group.title}</span>
                  </div>
                  <div class="trigger-right">
                    <span class="section-count">{group.lessons.length}</span>
                    <span class="accordion-arrow">▾</span>
                  </div>
                </button>

                <!-- Section Chapters Grid -->
                <div class="accordion-content-panel">
                  {(() => {
                    const distinctSubTags = Array.from(new Set(group.lessons.map(l => l.subTag).filter(Boolean))) as string[];
                    if (distinctSubTags.length > 2) {
                      return (
                        <div class="subtag-filter-bar">
                          <button type="button" class="subtag-chip active" data-filter="all">
                            All ({group.lessons.length})
                          </button>
                          {distinctSubTags.map((tag) => {
                            const count = group.lessons.filter(l => l.subTag === tag).length;
                            return (
                              <button type="button" class="subtag-chip" data-filter={tag.toLowerCase()}>
                                {tag} ({count})
                              </button>
                            );
                          })}
                        </div>
                      );
                    }
                    return null;
                  })()}
                  <div class="chapters-grid">
                    {group.lessons.map((lesson) => {
                      const isCurrentChapter = lesson.globalIndex === currentIndex;
                      return (
                        <a
                          href={lesson.href}
                          class={`chapter-nav-card ${isCurrentChapter ? 'active-chapter' : ''}`}
                          data-title={lesson.cleanTitle.toLowerCase()}
                          data-subtag={(lesson.subTag || '').toLowerCase()}
                          data-index={lesson.globalIndex + 1}
                        >
                          <div class="card-meta-row">
                            <span class="chapter-number">#{lesson.globalIndex + 1}</span>
                            {lesson.subTag && <span class="module-tag">{lesson.subTag}</span>}
                            {isCurrentChapter && <span class="active-dot">● CURRENT</span>}
                          </div>
                          <div class="chapter-label-text">{lesson.cleanTitle}</div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}

          <div id="noMatchContainer" class="no-match-state" style="display:none;">
            <div class="no-match-icon">🔍</div>
            <div class="no-match-title">No chapters found</div>
            <div class="no-match-sub">Try searching with a different term.</div>
          </div>
        </div>
      </div>
    </dialog>
  </nav>
)}

<script>
  // Modern Chapter Navigator Script
  const navModal = document.getElementById('modernNavModal') as HTMLDialogElement | null;
  const openBtn = document.getElementById('openModernNavBtn');
  const closeBtn = document.getElementById('closeModernNavBtn');
  const backdrop = document.getElementById('dialogBackdrop');
  const searchInput = document.getElementById('modernChapterSearchInput') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clearSearchInputBtn');
  const matchText = document.getElementById('searchMatchCountText');
  const noMatchBox = document.getElementById('noMatchContainer');
  const accordionItems = document.querySelectorAll('.section-accordion-item');
  const chapterCards = document.querySelectorAll('.chapter-nav-card');

  function openModal() {
    if (navModal && typeof navModal.showModal === 'function') {
      navModal.showModal();
      document.body.classList.add('nav-modal-open');

      // Make sure the section with active chapter is open and scrolled into view
      const activeItem = navModal.querySelector('.section-accordion-item.is-active-section') as HTMLElement | null;
      if (activeItem) {
        accordionItems.forEach(other => {
          if (other !== activeItem) {
            other.classList.remove('is-open');
            other.querySelector('.accordion-trigger-btn')?.setAttribute('aria-expanded', 'false');
          }
        });
        activeItem.classList.add('is-open');
        activeItem.querySelector('.accordion-trigger-btn')?.setAttribute('aria-expanded', 'true');

        // Scroll active card into view within the modal list
        const activeCard = activeItem.querySelector('.chapter-nav-card.active-chapter') as HTMLElement | null;
        if (activeCard) {
          setTimeout(() => {
            activeCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 120);
        }
      }

      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    }
  }

  function closeModal() {
    if (navModal) {
      navModal.close();
      document.body.classList.remove('nav-modal-open');
    }
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navModal?.open) {
      closeModal();
    }
  });

  // Accordion Toggle Behavior (Single open section keeps list compact)
  accordionItems.forEach(item => {
    const trigger = item.querySelector('.accordion-trigger-btn');
    trigger?.addEventListener('click', () => {
      const wasOpen = item.classList.contains('is-open');
      if (!wasOpen) {
        accordionItems.forEach(other => {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('.accordion-trigger-btn')?.setAttribute('aria-expanded', 'false');
          }
        });
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');

        // Scroll the newly opened section into comfortable view
        setTimeout(() => {
          item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 80);
      } else {
        item.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // In-section subtag filter chips
  document.querySelectorAll('.subtag-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      e.stopPropagation();
      const parentPanel = chip.closest('.accordion-content-panel');
      if (!parentPanel) return;

      const filterVal = (chip.getAttribute('data-filter') || 'all').toLowerCase();
      parentPanel.querySelectorAll('.subtag-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      parentPanel.querySelectorAll('.chapter-nav-card').forEach(card => {
        const cardTag = (card.getAttribute('data-subtag') || '').toLowerCase();
        if (filterVal === 'all' || cardTag === filterVal) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Real-time Search Filtering
  function filterChapters() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    let totalMatches = 0;

    if (clearBtn) {
      clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
    }

    if (!query) {
      // Reset view: restore original open/collapsed states
      accordionItems.forEach(item => {
        const isCurrentSec = item.classList.contains('is-active-section');
        item.classList.toggle('is-open', isCurrentSec);
        const trigger = item.querySelector('.accordion-trigger-btn');
        trigger?.setAttribute('aria-expanded', isCurrentSec ? 'true' : 'false');
        (item as HTMLElement).style.display = 'block';

        item.querySelectorAll('.chapter-nav-card').forEach(card => {
          (card as HTMLElement).style.display = 'flex';
        });
      });

      if (matchText) {
        matchText.textContent = `${chapterCards.length} chapters available`;
      }
      if (noMatchBox) noMatchBox.style.display = 'none';
      return;
    }

    // When searching: Expand sections that contain matching cards
    accordionItems.forEach(item => {
      let groupMatchCount = 0;
      const cards = item.querySelectorAll('.chapter-nav-card');

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const tag = card.getAttribute('data-subtag') || '';
        const idx = card.getAttribute('data-index') || '';

        const isMatch = title.includes(query) || tag.includes(query) || idx === query;
        if (isMatch) {
          (card as HTMLElement).style.display = 'flex';
          groupMatchCount++;
          totalMatches++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (groupMatchCount > 0) {
        (item as HTMLElement).style.display = 'block';
        item.classList.add('is-open');
        const trigger = item.querySelector('.accordion-trigger-btn');
        trigger?.setAttribute('aria-expanded', 'true');
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (matchText) {
      matchText.textContent = `${totalMatches} chapters found`;
    }
    if (noMatchBox) {
      noMatchBox.style.display = totalMatches === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterChapters);

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      filterChapters();
    }
  });

  // Jump to first matching chapter on Enter
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const firstMatch = document.querySelector('.chapter-nav-card:not([style*="display: none"])') as HTMLAnchorElement | null;
      if (firstMatch && firstMatch.href) {
        window.location.href = firstMatch.href;
      }
    }
  });
</script>

