    max-width: 920px;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
    padding-bottom: max(2.5rem, env(safe-area-inset-bottom, 24px));
    width: 100%;
    overflow-x: hidden;
  }

  @media (min-width: 768px) {
    .sector-pagination {
      margin: 3.5rem auto 1.5rem;
      gap: 1.35rem;
    }
  }

  /* Header Row */
  .pagination-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 0.25rem;
  }

  @media (max-width: 640px) {
    .pagination-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
  }

  .header-left-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
