---
const { id } = Astro.locals.starlightRoute;
const sidebar = Astro.locals.starlightRoute.sidebar || [];

// Helper to recursively flatten sidebar links in a group
function flattenGroup(entries: any[]): Array<{ href: string; label: string; isCurrent: boolean }> {
  let result: any[] = [];
  if (!entries || !Array.isArray(entries)) return result;
  for (const item of entries) {
    if (item.type === 'link') {
      result.push(item);
    } else if (item.type === 'group' && item.entries) {
      result = result.concat(flattenGroup(item.entries));
    }
  }
  return result;
}

const norm = (url: string) => (url || '').replace(/\/+$/, '').toLowerCase();
const currentPath = norm(Astro.url.pathname);
const currentId = (id || '').replace(/\.md$/, '').toLowerCase();

// Find the course group that contains the current lesson
let currentGroup: any = null;
let sectorLessons: Array<{ href: string; label: string; isCurrent: boolean }> = [];

for (const group of sidebar) {
  if (group.type === 'group') {
    const flat = flattenGroup(group.entries);
    const hasCurrent = flat.some(item => {
      const itemHref = norm(item.href);
      return item.isCurrent || (currentPath && itemHref === currentPath) || (currentId && itemHref.includes(currentId));
    });
    if (hasCurrent) {
      currentGroup = group;
      sectorLessons = flat;
      break;
    }
  }
}

// Fallback matching by first path segment (e.g. /javascript/...)
if (!currentGroup && currentPath) {
  const segments = currentPath.split('/').filter(Boolean);
  const sectorSegment = segments[0]; // 'javascript', 'php', etc.
  if (sectorSegment) {
    for (const group of sidebar) {
      if (group.type === 'group') {
        const flat = flattenGroup(group.entries);
        if (flat.some(item => norm(item.href).includes(`/${sectorSegment}/`))) {
          currentGroup = group;
          sectorLessons = flat;
          break;
        }
      }
    }
  }
}

const totalLessons = sectorLessons.length;
const currentIndex = sectorLessons.findIndex(item => {
  const itemHref = norm(item.href);
  return item.isCurrent || (currentPath && itemHref === currentPath) || (currentId && itemHref.includes(currentId));
});

const currentNum = currentIndex >= 0 ? currentIndex + 1 : 1;
const prevLesson = currentIndex > 0 ? sectorLessons[currentIndex - 1] : null;
const nextLesson = currentIndex >= 0 && currentIndex < totalLessons - 1 ? sectorLessons[currentIndex + 1] : null;

const sectorTitle = currentGroup ? currentGroup.label : '';
const progressPercent = totalLessons > 0 ? Math.round((currentNum / totalLessons) * 100) : 0;

// Sector Icons
const sectorIcons: Record<string, string> = {
  'PHP': '🐘',
  'JavaScript': '⚡',
  'Laravel': '🔺',
  'MySQL': '🗄️',
  'EC-CUBE': '🛍️',
  'Docker & DevOps': '🐳',
  'TOEIC': '🎯',
  'Japanese N1 Grammar': '⛩️',
  'Japanese N1 Vocabulary': '📖',
  'Japanese N1 Kanji': '🈸',
  'AWS Cloud & DevOps': '☁️',
};
const sectorIcon = sectorIcons[sectorTitle] || '📚';

// Smart Window Pagination generator
function getPaginationItems(currentIdx: number, total: number) {
  if (total <= 9) {
    return Array.from({ length: total }, (_, i) => ({ type: 'page', num: i + 1, index: i }));
  }
  const items: Array<{ type: 'page' | 'ellipsis'; num?: number; index?: number }> = [];
  const start = Math.max(0, currentIdx - 2);
  const end = Math.min(total - 1, currentIdx + 2);

  if (start > 0) {
    items.push({ type: 'page', num: 1, index: 0 });
    if (start > 1) items.push({ type: 'ellipsis' });
  }

  for (let i = start; i <= end; i++) {
    items.push({ type: 'page', num: i + 1, index: i });
  }

  if (end < total - 1) {
    if (end < total - 2) items.push({ type: 'ellipsis' });
    items.push({ type: 'page', num: total, index: total - 1 });
  }
  return items;
}

const paginationItems = totalLessons > 0 ? getPaginationItems(currentIndex >= 0 ? currentIndex : 0, totalLessons) : [];
---

{totalLessons > 0 && (
  <nav class="sector-pagination print:hidden" aria-label="Course Lesson Navigation">
    <!-- Top Bar: Sector Identity, Progress & Quick Jump Dropdown -->
    <div class="pagination-header">
      <div class="header-left-meta">
        <div class="sector-badge">
          <span class="sector-icon">{sectorIcon}</span>
          <span class="sector-name">{sectorTitle} Track</span>
        </div>
        <div class="progress-info">
          <span class="lesson-counter">Lesson {currentNum} of {totalLessons}</span>
          <span class="progress-divider">•</span>
          <span class="progress-percent">{progressPercent}% complete</span>
        </div>
      </div>

      <!-- Quick Jump & Track Switcher -->
      <div class="header-right-actions">
        <div class="chapter-jump-wrapper">
          <label for="chapterSelect" class="sr-only">Jump to chapter</label>
          <select
            id="chapterSelect"
            class="chapter-select"
            onchange="if (this.value) window.location.href = this.value;"
          >
            <option value="" disabled>Jump to chapter ({totalLessons} lessons)...</option>
            {sectorLessons.map((lesson, idx) => {
              const clean = (lesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '');
              return (
                <option value={lesson.href} selected={idx === currentIndex}>
                  {idx + 1}. {clean}
                </option>
              );
            })}
          </select>
        </div>

        <button
          type="button"
          class="switch-track-btn"
          onclick="const m = document.getElementById('trackModal'); if (m && typeof m.showModal === 'function') { m.showModal(); } else { window.location.href = '/#programs'; }"
          title="Switch to Japanese N1 or other tracks"
        >
          <span>All Tracks ▾</span>
        </button>
      </div>
    </div>

    <!-- Progress Bar Line -->
    <div class="progress-track" role="progressbar" aria-valuenow={progressPercent} aria-valuemin="0" aria-valuemax="100">
      <div class="progress-fill" style={`width: ${progressPercent}%;`}></div>
    </div>

    <!-- Numbered Page Pills -->
    {totalLessons > 1 && (
      <div class="numbered-pagination">
        {prevLesson ? (
          <a href={prevLesson.href} class="page-pill nav-arrow" title="Previous Lesson">
            ◀
          </a>
        ) : (
          <span class="page-pill nav-arrow disabled" aria-disabled="true">
            ◀
          </span>
        )}

        <div class="numbered-pills-list">
          {paginationItems.map((item) => {
            if (item.type === 'ellipsis') {
              return <span class="page-pill ellipsis">…</span>;
            }
            const isCur = item.index === currentIndex;
            const targetLesson = item.index !== undefined ? sectorLessons[item.index] : null;
            return targetLesson ? (
              <a
                href={targetLesson.href}
                class={`page-pill ${isCur ? 'active' : ''}`}
                title={`Go to Lesson ${item.num}: ${targetLesson.label}`}
                aria-current={isCur ? 'page' : undefined}
              >
                {item.num}
              </a>
            ) : null;
          })}
        </div>

        {nextLesson ? (
          <a href={nextLesson.href} class="page-pill nav-arrow" title="Next Lesson">
            ▶
          </a>
        ) : (
          <span class="page-pill nav-arrow disabled" aria-disabled="true">
            ▶
          </span>
        )}
      </div>
    )}

    <!-- Prev & Next Action Cards (Compact, Modern Klook Style) -->
    <div class="cards-grid">
      <!-- Previous Card -->
      {prevLesson ? (
        <a href={prevLesson.href} class="lesson-card prev-card" rel="prev">
          <div class="card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </div>
          <div class="card-content">
            <span class="card-label">PREVIOUS LESSON</span>
            <span class="card-title">{(prevLesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '')}</span>
          </div>
        </a>
      ) : (
        <div class="lesson-card disabled-card">
          <div class="card-arrow muted-arrow">✦</div>
          <div class="card-content">
            <span class="card-label">TRACK START</span>
            <span class="card-title">First lesson of this course</span>
          </div>
        </div>
      )}

      <!-- Next Card -->
      {nextLesson ? (
        <a href={nextLesson.href} class="lesson-card next-card" rel="next">
          <div class="card-content text-right">
            <span class="card-label">NEXT LESSON</span>
            <span class="card-title">{(nextLesson.label || '').replace(/^00\.\s*|^\d+[\.\-_]\s*/, '')}</span>
          </div>
          <div class="card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ) : (
        <a href="/" class="lesson-card complete-card">
          <div class="card-content text-right">
            <span class="card-label">🎉 COURSE COMPLETED</span>
            <span class="card-title">Explore All Programs ↗</span>
          </div>
          <div class="card-arrow celebration-arrow">🏆</div>
        </a>
      )}
    </div>
  </nav>
)}

<style>
