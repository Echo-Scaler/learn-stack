  .next-card {
    justify-content: flex-end;
  }

  .disabled-card {
    opacity: 0.55;
    background: var(--sl-color-hairline);
    cursor: default;
  }

  .complete-card {
    background: linear-gradient(135deg, var(--sl-sector-card-bg, rgba(255, 91, 0, 0.06)), rgba(255, 138, 0, 0.02));
    border-color: var(--sl-sector-primary, #ff5b00);
  }

  .card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--sl-color-hairline);
