{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd my-learning-hub && npm install && npm run build",
  "outputDirectory": "my-learning-hub/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)\\.md",
      "destination": "/$1/",
      "permanent": true
    },
    {
      "source": "/aws",
      "destination": "/aws/00_overview/",
      "permanent": false
    },
    {
      "source": "/php",
      "destination": "/php/00_overview/",
      "permanent": false
    },
    {
      "source": "/javascript",
      "destination": "/javascript/00_overview/",
      "permanent": false
    },
    {
      "source": "/networking",
      "destination": "/networking/00_overview/",
      "permanent": false
    },
    {
      "source": "/laravel",
      "destination": "/laravel/00_overview/",
      "permanent": false
    },
    {
      "source": "/mysql",
      "destination": "/mysql/00_overview/",
      "permanent": false
    },
    {
      "source": "/devops",
      "destination": "/devops/01_docker_core/01-docker-fundamentals-and-architecture/",
      "permanent": false
    },
    {
      "source": "/eccube",
      "destination": "/eccube/00_overview/",
      "permanent": false
    },
    {
      "source": "/eccube/requirements",
      "destination": "/eccube/requirements/readme/",
      "permanent": false
    },
    {
      "source": "/eccube/(03_order_management|04_payment|05_shipping|06_customer_management|07_security|08_campaign_coupon|api-integration|auth-permission|customization-list|email-management|event-subscriber|favorite-wishlist|line-marketing|performance|product-management|sales-reports|search-filter)/:path*",
      "destination": "/eccube/requirements/$1/:path*",
      "permanent": true
    },
    {
      "source": "/toeic",
      "destination": "/toeic/00_study_plan_roadmap/01_score_breakdown_and_strategy/",
      "permanent": false
    },
    {
      "source": "/japanese",
      "destination": "/japanese-grammar/00_n1_overview_and_strategy/01_n1_exam_structure_and_study_guide/",
      "permanent": false
    },
    {
      "source": "/japanese-grammar",
      "destination": "/japanese-grammar/00_n1_overview_and_strategy/01_n1_exam_structure_and_study_guide/",
      "permanent": false
    },
    {
      "source": "/japanese-vocab",
      "destination": "/japanese-vocab/01_high_frequency_verbs/",
      "permanent": false
    },
    {
      "source": "/japanese-kanji",
      "destination": "/japanese-kanji/00_n1_kanji_overview_and_strategy/",
      "permanent": false
    },
    {
      "source": "/kanji",
      "destination": "/japanese-kanji/00_n1_kanji_overview_and_strategy/",
      "permanent": false
    }
  ]
}
